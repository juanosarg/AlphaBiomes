	<ThingDef ParentName="BuildingBase">
		<defName>AB_BoneDistillery</defName>
		<label>bone drill</label>
		<description>A powerful hydraulic drill designed to bore into ancient bone deposits buried deep beneath the ground, breaking them loose for extraction and processing.</description>
		<thingClass>Building</thingClass>
		<graphicData>
			<texPath>Things/Building/GallatrossGraveyard/AB_BoneDistillery</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(4,4)</drawSize>
			<shadowData>
				<volume>(2.6,1,2.16)</volume>
				<offset>(-0.20,0,0)</offset>
			</shadowData>
			<damageData>
				<rectN>(0.1,1.2,4.75,3.25)</rectN>
				<rectE>(1.25,0.2,3.5,4.7)</rectE>
				<rectS>(0.2,1.2,4.7,3.25)</rectS>
				<rectW>(1.25,0.2,3.5,4.7)</rectW>
			</damageData>
		</graphicData>
		<castEdgeShadows>false</castEdgeShadows>
		<staticSunShadowHeight>0</staticSunShadowHeight>
		<altitudeLayer>Building</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<blockWind>true</blockWind>
		<scatterableOnMapGen>false</scatterableOnMapGen>
		<fillPercent>0.5</fillPercent>
		<blockLight>true</blockLight>
		<canOverlapZones>false</canOverlapZones>
		<statBases>
			<MaxHitPoints>250</MaxHitPoints>
			<WorkToBuild>2000</WorkToBuild>
			<Flammability>1.0</Flammability>
			<Beauty>-20</Beauty>
		</statBases>
		<tickerType>Normal</tickerType>
		<size>(2,2)</size>
		<costList>
			<Steel>150</Steel>
			<ComponentIndustrial>3</ComponentIndustrial>
		</costList>
		<uiIconScale>0.75</uiIconScale>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>150</basePowerConsumption>
				<shortCircuitInRain>false</shortCircuitInRain>
			</li>
			<li Class="CompProperties_Breakdownable"/>
			<li Class="CompProperties_Flickable"/>
			<li Class="CompProperties_Spawner">
				<requiresPower>true</requiresPower>
				<thingToSpawn>AB_AncientBone</thingToSpawn>
				<spawnCount>75</spawnCount>
				<spawnIntervalRange>
					<min>180000</min>
					<max>180000</max>
				</spawnIntervalRange>
				<writeTimeLeftToSpawn>true</writeTimeLeftToSpawn>
				<showMessageIfOwned>true</showMessageIfOwned>
			</li>
		</comps>
		<rotatable>false</rotatable>
		<terrainAffordanceNeeded/>
		<designationCategory>Furniture</designationCategory>
		<placeWorkers>
			<li>AlphaBiomes.PlaceWorker_GenericDistance_Fifteen</li>
		</placeWorkers>
		<building>
			<ai_chillDestination>false</ai_chillDestination>
		</building>
		<researchPrerequisites>
			<li>Electricity</li>
		</researchPrerequisites>
		<constructionSkillPrerequisite>6</constructionSkillPrerequisite>
	</ThingDef>
