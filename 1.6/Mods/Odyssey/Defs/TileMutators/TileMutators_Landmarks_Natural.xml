		</plantKinds>
		<modExtensions>
			<li Class="VEF.Maps.TileMutatorExtension">
				<plantDefsWithCommonality>
					<li>
						<plantDef>AB_AlienGrass</plantDef>
						<commonality>5</commonality>
					</li>
					<li>
						<plantDef>AB_Plant_OcularCactus_Small</plantDef>
						<commonality>2</commonality>
					</li>
					<li>
						<plantDef>AB_Plant_OcularCactus_Large</plantDef>
						<commonality>1</commonality>
					</li>
					<li>
						<plantDef>AB_DesertBouquet</plantDef>
						<commonality>1</commonality>
					</li>
