<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<ThingDef ParentName="BuildingBase">
		<defName>AB_SugarChunk</defName>
		<label>sugar chunk</label>
		<description>A chunk of sugar. It can be deconstructed to acquire some sugar (if you are using VE Cooking).</description>
		<graphicData>
			 <texPath>Things/Item/Chunk/ChunkStone</texPath>
			  <graphicClass>Graphic_Random</graphicClass>
			  <flipExtraRotation>80</flipExtraRotation>
		</graphicData>
		<thingClass>Building</thingClass>
		<altitudeLayer>Item</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.5</fillPercent>
		<preventGravshipLandingOn>false</preventGravshipLandingOn>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<Flammability>0</Flammability>
			<Beauty>-5</Beauty>
		</statBases>
		<selectable>true</selectable>
		<pathCost>42</pathCost>
		<pathCostIgnoreRepeat>true</pathCostIgnoreRepeat>
		<building>
			<isEdifice>true</isEdifice>
			<claimable>false</claimable>
			<deconstructible>true</deconstructible>
			<alwaysDeconstructible>true</alwaysDeconstructible>
		</building>
		<killedLeavings>
			<VCE_RawSugar MayRequire="VanillaExpanded.VCookE">1</VCE_RawSugar>
		</killedLeavings>
		<costList>
			<VCE_RawSugar MayRequire="VanillaExpanded.VCookE">1</VCE_RawSugar>
		</costList>
	</ThingDef>
	
	<ThingDef ParentName="BuildingBase">
		<defName>AB_WarpedStonePillar</defName>
		<label>warped stone pillar</label>
		<description>A sandstone pillar warped into an unnatural form.</description>
		<graphicData>
			<texPath>Things/Building/AB_WarpedStonePillar</texPath>
			<graphicClass>Graphic_Random</graphicClass>
			<drawSize>4</drawSize>
		</graphicData>
		<thingClass>Building</thingClass>
		<altitudeLayer>Item</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.30</fillPercent>
		<preventGravshipLandingOn>false</preventGravshipLandingOn>
		<statBases>
			<MaxHitPoints>350</MaxHitPoints>
			<Flammability>0</Flammability>
			<Beauty>1</Beauty>
			<WorkToMake>3500</WorkToMake>
		</statBases>
		<selectable>true</selectable>
		<pathCost>90</pathCost>
		<pathCostIgnoreRepeat>true</pathCostIgnoreRepeat>
		<building>
			
			<isEdifice>true</isEdifice>
			<claimable>false</claimable>
			<deconstructible>true</deconstructible>
			<alwaysDeconstructible>true</alwaysDeconstructible>
		</building>
		<killedLeavings>
			<ChunkSandstone>4</ChunkSandstone>
		</killedLeavings>
		<costList>
			<ChunkSandstone>4</ChunkSandstone>
		</costList>
	</ThingDef>
	
	<ThingDef ParentName="BuildingBase">
		<defName>AB_ObsidianSpire</defName>
		<label>obsidian spire</label>
		<description>A large spire made of solid obsidian.</description>
		<graphicData>
			<texPath>Things/Building/AB_ObsidianSpire</texPath>
			<graphicClass>Graphic_Random</graphicClass>
			<drawSize>4</drawSize>
		</graphicData>
		<thingClass>Building</thingClass>
		<altitudeLayer>Item</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.30</fillPercent>
		<preventGravshipLandingOn>false</preventGravshipLandingOn>
		<statBases>
			<MaxHitPoints>1000</MaxHitPoints>
			<Flammability>0</Flammability>
			<Beauty>1</Beauty>
			<WorkToMake>3500</WorkToMake>
		</statBases>
		<selectable>true</selectable>
		<pathCost>90</pathCost>
		<pathCostIgnoreRepeat>true</pathCostIgnoreRepeat>
		<building>
			
			<isEdifice>true</isEdifice>
			<claimable>false</claimable>
			<deconstructible>true</deconstructible>
			<alwaysDeconstructible>true</alwaysDeconstructible>
		</building>
		<killedLeavings>
			<Obsidian>2</Obsidian>
		</killedLeavings>
		<costList>
			<Obsidian>2</Obsidian>
		</costList>
	</ThingDef>
	<ThingDef ParentName="BuildingBase">
		<defName>AB_NeutroamineSynthetizer</defName>
		<label>neutroamine synthetizer</label>
		<description>A specialized synthetizer that extracts neutroamine from the cerebrospinal fluid of vast surface lakes, processing it into a usable form.</description>
		<thingClass>Building</thingClass>
		<graphicData>
			<texPath>Things/Building/AB_NeutroamineSynthetizer</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(4,4)</drawSize>
			<shadowData>
				<volume>(2.6,1,2.16)</volume>
				<offset>(-0.20,0,0)</offset>
			</shadowData>
			<damageData>
				<rectN>(0.1,1.2,4.75,3.25)</rectN>
				<rectE>(1.25,0.2,3.5,4.7)</rectE>
				<rectS>(0.2,1.2,4.7,3.25)</rectS>
				<rectW>(1.25,0.2,3.5,4.7)</rectW>
			</damageData>
		</graphicData>
		<castEdgeShadows>false</castEdgeShadows>
		<staticSunShadowHeight>0</staticSunShadowHeight>
		<altitudeLayer>Building</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<blockWind>true</blockWind>
		<scatterableOnMapGen>false</scatterableOnMapGen>
		<fillPercent>0.5</fillPercent>
		<blockLight>true</blockLight>
		<canOverlapZones>false</canOverlapZones>
		<statBases>
			<MaxHitPoints>250</MaxHitPoints>
			<WorkToBuild>2000</WorkToBuild>
			<Flammability>1.0</Flammability>
			<Beauty>-20</Beauty>
		</statBases>
		<tickerType>Normal</tickerType>
		<size>(2,2)</size>
		<costList>
			<Steel>150</Steel>
			<ComponentIndustrial>3</ComponentIndustrial>
		</costList>
		<uiIconScale>0.75</uiIconScale>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>150</basePowerConsumption>
				<shortCircuitInRain>false</shortCircuitInRain>
			</li>
			<li Class="CompProperties_Breakdownable"/>
			<li Class="CompProperties_Flickable"/>
			<li Class="CompProperties_Spawner">
				<requiresPower>true</requiresPower>
				<thingToSpawn>Neutroamine</thingToSpawn>
				<spawnCount>1</spawnCount>
				<spawnIntervalRange>
					<min>180000</min>
					<max>180000</max>
				</spawnIntervalRange>
				<writeTimeLeftToSpawn>true</writeTimeLeftToSpawn>
				<showMessageIfOwned>true</showMessageIfOwned>
			</li>
		</comps>
		<rotatable>false</rotatable>
		<terrainAffordanceNeeded/>
		<designationCategory>Furniture</designationCategory>
		<placeWorkers>
			<li>AlphaBiomes.PlaceWorker_GenericDistance_Fifteen</li>
		</placeWorkers>
		<building>
			<ai_chillDestination>false</ai_chillDestination>
		</building>
		<researchPrerequisites>
			<li>Electricity</li>
		</researchPrerequisites>
		<constructionSkillPrerequisite>6</constructionSkillPrerequisite>
	</ThingDef>
</Defs>
