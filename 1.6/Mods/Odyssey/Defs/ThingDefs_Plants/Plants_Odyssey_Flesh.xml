<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<ThingDef ParentName="TreeBase">
		<defName>AB_FleshTree</defName>
		<label>flesh tree</label>
		<description>A grotesque growth of pulsing, veiny tissue stretched over a warped wooden frame. Its "bark" oozes with coagulated sap that smells faintly of blood.\n\nPlant details: Flesh trees are wild plants, and they need minimum terrain fertility of 0.7. Can be harvested for wood and twisted flesh.\n\nInspired by art by Prajwal K Kumar https://www.artstation.com/prajwalkkumar</description>
		<descriptionHyperlinks>
			<ThingDef>WoodLog</ThingDef>
			<ThingDef MayRequire="Ludeon.RimWorld.Anomaly">Meat_Twisted</ThingDef>
		</descriptionHyperlinks>
		<graphicData>
			<texPath>Things/Plants/AB_FleshTree</texPath>
			<graphicClass>Graphic_Random</graphicClass>
			<shadowData>
				<volume>(0.18, 0.3, 0.15)</volume>
			</shadowData>
		</graphicData>
		<altitudeLayer>BuildingOnTop</altitudeLayer>
		<statBases>
			<Beauty>-15</Beauty>
			<BeautyOutdoors>-15</BeautyOutdoors>
			<Nutrition>1.5</Nutrition>
		</statBases>
		<plant>
			<growDays>14</growDays>
			<harvestWork>550</harvestWork>
			<harvestYield>25</harvestYield>
			<wildClusterRadius>10</wildClusterRadius>
			<wildClusterWeight>11</wildClusterWeight>
			<visualSizeRange>2.1~3</visualSizeRange>
			<choppedThingDef IsNull="True"/>
			<smashedThingDef IsNull="True"/>
		</plant>
		<ingestible/>
		<modExtensions>
			<li Class="VEF.Plants.DualCropExtension">
				<secondaryOutput MayRequire="Ludeon.RimWorld.Anomaly">Meat_Twisted</secondaryOutput>
				<outPutAmount>10</outPutAmount>
			</li>
		</modExtensions>
	</ThingDef>
	<ThingDef ParentName="TreeBase" MayRequire="Ludeon.RimWorld.Anomaly">
		<defName>AB_FleshyTumor</defName>
		<label>fleshy tumor</label>
		<description>An irregular tumorous growth that swells from the ground like diseased flesh, spreading across the landscape.\n\nPlant details: fleshy tumors are wild plants, and they need minimum terrain fertility of 0.7. Can be harvested for twisted flesh.\n\nInspired by No Man's Sky.</description>
		<descriptionHyperlinks>
			<ThingDef MayRequire="Ludeon.RimWorld.Anomaly">Meat_Twisted</ThingDef>
		</descriptionHyperlinks>
		<graphicData>
			<texPath>Things/Plants/AB_FleshyTumor</texPath>
			<graphicClass>Graphic_Random</graphicClass>
			<shadowData>
				<volume>(0.18, 0.3, 0.15)</volume>
			</shadowData>
		</graphicData>
		<altitudeLayer>BuildingOnTop</altitudeLayer>
		<statBases>
			<Beauty>-15</Beauty>
			<BeautyOutdoors>-15</BeautyOutdoors>
			<Nutrition>1.5</Nutrition>
		</statBases>
		<plant>
			<growDays>14</growDays>
			<harvestWork>550</harvestWork>
			<harvestYield>5</harvestYield>
			<harvestedThingDef MayRequire="Ludeon.RimWorld.Anomaly">Meat_Twisted</harvestedThingDef>
			<wildClusterRadius>10</wildClusterRadius>
			<wildClusterWeight>11</wildClusterWeight>
			<visualSizeRange>2.1~3</visualSizeRange>
			<choppedThingDef IsNull="True"/>
			<smashedThingDef IsNull="True"/>
		</plant>
		<ingestible/>
	</ThingDef>
	<ThingDef ParentName="TreeBase" MayRequire="Ludeon.RimWorld.Anomaly">
		<defName>AB_FleshTentacle</defName>
		<label>flesh tentacle</label>
		<description>A fleshy tendril that erupts from the ground, twisting and writhing as though part of some unseen organism.\n\nPlant details: flesh tentacles are wild plants, and they need minimum terrain fertility of 0.7. Can be harvested for twisted flesh.</description>
		<descriptionHyperlinks>
			<ThingDef MayRequire="Ludeon.RimWorld.Anomaly">Meat_Twisted</ThingDef>
		</descriptionHyperlinks>
		<graphicData>
			<texPath>Things/Plants/AB_FleshTentacle</texPath>
			<graphicClass>Graphic_Random</graphicClass>
			<shadowData>
				<volume>(0.18, 0.3, 0.15)</volume>
			</shadowData>
		</graphicData>
		<altitudeLayer>BuildingOnTop</altitudeLayer>
		<statBases>
			<Beauty>-8</Beauty>
			<BeautyOutdoors>-8</BeautyOutdoors>
			<Nutrition>1</Nutrition>
		</statBases>
		<plant>
			<growDays>7</growDays>
			<harvestWork>250</harvestWork>
			<harvestYield>2</harvestYield>
			<harvestedThingDef MayRequire="Ludeon.RimWorld.Anomaly">Meat_Twisted</harvestedThingDef>
			<visualSizeRange>1~1.85</visualSizeRange>
			<choppedThingDef IsNull="True"/>
			<smashedThingDef IsNull="True"/>
		</plant>
		<ingestible/>
	</ThingDef>
	<ThingDef ParentName="PlantBase">
		<defName>AB_TentacleGrass</defName>
		<label>flesh tentacle grass</label>
		<description>Looks dangerous.</description>
		<statBases>
			<MaxHitPoints>85</MaxHitPoints>
			<Flammability>1.3</Flammability>
			<Nutrition>0.30</Nutrition>
		</statBases>
		<graphicData>
			<texPath>Things/Plants/AB_TentacleGrass</texPath>
			<graphicClass>Graphic_Random</graphicClass>
		</graphicData>
		<hideAtSnowOrSandDepth>0.5</hideAtSnowOrSandDepth>
		<ingestible/>
		<selectable>false</selectable>
		<plant>
			<growDays>2.5</growDays>
			<harvestWork>40</harvestWork>
			<maxMeshCount>9</maxMeshCount>
			<visualSizeRange>0.4~0.6</visualSizeRange>
			<topWindExposure>0.4</topWindExposure>
			<wildOrder>1</wildOrder>
		</plant>
	</ThingDef>
</Defs>
